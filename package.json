{
  "name": "agent-office",
  "version": "0.3.3",
  "private": true,
  "description": "Escritório isométrico onde agentes do Claude Code trabalham, pedem permissão e entregam resultados.",
  "main": "./out/main/index.js",
  "author": "Allef Schmidt",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:mac": "electron-vite build && node scripts/dist-mac.mjs",
    "dist:win": "electron-vite build && electron-builder --win",
    "demo": "AGENT_OFFICE_DEMO=1 electron-vite dev",
    "icon": "node scripts/make-icon.mjs",
    "dmg-bg": "electron scripts/make-dmg-background.mjs",
    "lint": "eslint .",
    "format": "prettier --write"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "electron-updater": "^6.8.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "marked": "^18.1.0",
    "prettier": "^3.9.10",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "type": "module"
}
