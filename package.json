{
  "name": "agent-office",
  "version": "0.2.0",
  "private": true,
  "description": "Escritório isométrico onde agentes do Claude Code trabalham, pedem permissão e entregam resultados.",
  "main": "./out/main/index.js",
  "author": "Allef Schmidt",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "demo": "node scripts/demo.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "marked": "^18.1.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "type": "module"
}
